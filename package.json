{
  "name": "mindpc",
  "version": "1.0.0",
  "description": "Local-first digital wellbeing tracker. Your data stays on your computer.",
  "main": "main.js",
  "scripts": {
    "start": "pnpm build:dashboard && electron .",
    "build:dashboard": "pnpm --dir dashboard build",
    "dev": "concurrently -k -n dashboard,app \"pnpm --dir dashboard dev\" \"wait-on tcp:5173 && cross-env MINDPC_DEV_URL=http://localhost:5173 electronmon .\"",
    "test": "jest"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dashboard/"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "active-win"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/night30nk/MindPC.git"
  },
  "keywords": [
    "electron",
    "react",
    "digital",
    "wellbeing"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/night30nk/MindPC/issues"
  },
  "homepage": "https://github.com/night30nk/MindPC#readme",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "jest": "^30.5.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "active-win": "^9.0.0",
    "electronmon": "^2.0.4"
  }
}
