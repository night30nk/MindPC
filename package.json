{
  "name": "mindpc",
  "version": "1.0.0",
  "description": "Local-first digital wellbeing tracker. Your data stays on your computer.",
  "main": "main.js",
  "scripts": {
    "start": "pnpm build:dashboard && electron .",
    "build:dashboard": "pnpm --dir dashboard build",
    "dev": "concurrently -k -n dashboard,app \"pnpm --dir dashboard dev\" \"wait-on tcp:5173 && cross-env MINDPC_DEV_URL=http://localhost:5173 electronmon .\"",
    "test": "jest",
    "icons": "node scripts/make-icons.js",
    "dist:dir": "pnpm build:dashboard && electron-builder --dir",
    "dist": "pnpm build:dashboard && electron-builder --publish never",
    "dist:mac": "pnpm build:dashboard && electron-builder --mac",
    "dist:win": "pnpm build:dashboard && electron-builder --win",
    "dist:linux": "pnpm build:dashboard && electron-builder --linux",
    "smoke": "node scripts/smoke-test.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dashboard/"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "active-win",
      "electron"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/night30nk/MindPC.git"
  },
  "keywords": [
    "electron",
    "react",
    "digital",
    "wellbeing"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/night30nk/MindPC/issues"
  },
  "homepage": "https://github.com/night30nk/MindPC#readme",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "jest": "^30.5.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "active-win": "^9.0.0"
  },
  "productName": "MindPC",
  "build": {
    "appId": "com.mindpc.app",
    "productName": "MindPC",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "*.js",
      "!**/*.test.js",
      "assets/**",
      "dashboard/dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "MindPC <noreply@users.noreply.github.com>"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "npmRebuild": false,
    "asar": false,
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "x11-utils"
      ]
    }
  }
}
